    PROC Path_home() !lleva el robot a home
        MoveJ Target_Home,v100,z10,MyNewTool\WObj:=wobj0;
    ENDPROC
    
    PROC main()
        SetDO DO_01, 0; !El sistema inicia con todas las salidas apagadas
        SetDO DO_02, 0;
        SetDO DO_03, 0;
        WHILE TRUE DO
        Path_home; !El robot siempre inicia la rutina en home
        
            IF DI_01=1 THEN
                Set DO_01;
                Set BWD_Conveyor; !la banda transporta el pastel a la posición inicial
                WaitTime 1; !tiempo de espera por seguridad
                Reset BWD_Conveyor;
                Path_names; !se hacen los trazos para hacer los nombres de los miembros del equipo
                Path_icon;  !se hacen los trazos para hacer un ícono
                WaitTime 2; !tiempo de espera por seguridad
                Path_home; !el robot vuelve a home
                Set BWD_Conveyor; !la banda transporta el pastel a la posición final
                Reset BWD_Conveyor;
                Reset DO_01;
            ENDIF
            IF DI_02=1 THEN
                Set DO_02; 
                Path_maintenance; !el robot va a la posición de mantenimiento donde se hace el montaje de la herramienta
                Path_home; !retorna a home
                Reset DO_02;
            ENDIF
            IF DI_03=1 THEN
                Set FWD_Conveyor; !La banda transporta el pastel a la posición inicial
                WaitTime 1; !tiempo de espera por seguridad
                Reset FWD_Conveyor;
            ENDIF
        ENDWHILE
    ENDPROC
        
        
    
    PROC Path_maintenance() !lleva al robot a la posición de mantenimiento
        MoveJ Target_10,v100,z10,MyNewTool\WObj:=wobj0;
    ENDPROC
    
