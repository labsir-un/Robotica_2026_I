<?xml version="1.0" encoding="UTF-8"?>
<!-- SRDF for PhantomX Pincher Robot Arm & Cell Environment -->
<robot name="phantomx_pincher">

  <!-- GROUPS -->
  <group name="arm">
    <chain base_link="phantomx_pincher_arm_base_link" tip_link="phantomx_pincher_end_effector"/>
  </group>

  <group name="gripper">
    <joint name="phantomx_pincher_gripper_finger1_joint"/>
    <joint name="phantomx_pincher_gripper_finger2_joint"/>
  </group>

  <!-- END EFFECTOR -->
  <end_effector name="phantomx_pincher_end_effector" parent_link="phantomx_pincher_gripper_finger_base_link" group="gripper" parent_group="arm"/>

  <!-- VIRTUAL JOINT -->
  <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="world"/>

  <!-- GROUP STATES (NAMED POSES) -->
  <group_state name="up" group="arm">
    <joint name="phantomx_pincher_arm_shoulder_pan_joint" value="0.0"/>
    <joint name="phantomx_pincher_arm_shoulder_lift_joint" value="0.0"/>
    <joint name="phantomx_pincher_arm_elbow_flex_joint" value="0.0"/>
    <joint name="phantomx_pincher_arm_wrist_flex_joint" value="0.0"/>
  </group_state>

  <group_state name="rest" group="arm">
    <joint name="phantomx_pincher_arm_shoulder_pan_joint" value="0.0"/>
    <joint name="phantomx_pincher_arm_shoulder_lift_joint" value="-1.5707"/>
    <joint name="phantomx_pincher_arm_elbow_flex_joint" value="2.2689"/>
    <joint name="phantomx_pincher_arm_wrist_flex_joint" value="1.5707"/>
  </group_state>

  <group_state name="home" group="arm">
    <joint name="phantomx_pincher_arm_shoulder_pan_joint" value="0.0"/>
    <joint name="phantomx_pincher_arm_shoulder_lift_joint" value="-1.5707"/>
    <joint name="phantomx_pincher_arm_elbow_flex_joint" value="2.2689"/>
    <joint name="phantomx_pincher_arm_wrist_flex_joint" value="1.5707"/>
  </group_state>

  <group_state name="scan" group="arm">
    <joint name="phantomx_pincher_arm_shoulder_pan_joint" value="0.0"/>
    <joint name="phantomx_pincher_arm_shoulder_lift_joint" value="0.0"/>
    <joint name="phantomx_pincher_arm_elbow_flex_joint" value="1.5707"/>
    <joint name="phantomx_pincher_arm_wrist_flex_joint" value="1.5707"/>
  </group_state>

  <group_state name="recovery" group="arm">
    <joint name="phantomx_pincher_arm_shoulder_pan_joint" value="0.0"/>
    <joint name="phantomx_pincher_arm_shoulder_lift_joint" value="-0.5"/>
    <joint name="phantomx_pincher_arm_elbow_flex_joint" value="1.5"/>
    <joint name="phantomx_pincher_arm_wrist_flex_joint" value="1.0"/>
  </group_state>

  <group_state name="pre_drop_green" group="arm">
    <joint name="phantomx_pincher_arm_shoulder_pan_joint" value="0.445"/>
    <joint name="phantomx_pincher_arm_shoulder_lift_joint" value="-0.35"/>
    <joint name="phantomx_pincher_arm_elbow_flex_joint" value="0.9"/>
    <joint name="phantomx_pincher_arm_wrist_flex_joint" value="1.0"/>
  </group_state>

  <group_state name="pre_drop_blue" group="arm">
    <joint name="phantomx_pincher_arm_shoulder_pan_joint" value="-0.445"/>
    <joint name="phantomx_pincher_arm_shoulder_lift_joint" value="-0.35"/>
    <joint name="phantomx_pincher_arm_elbow_flex_joint" value="0.9"/>
    <joint name="phantomx_pincher_arm_wrist_flex_joint" value="1.0"/>
  </group_state>

  <group_state name="pre_drop_red" group="arm">
    <joint name="phantomx_pincher_arm_shoulder_pan_joint" value="1.675"/>
    <joint name="phantomx_pincher_arm_shoulder_lift_joint" value="-0.35"/>
    <joint name="phantomx_pincher_arm_elbow_flex_joint" value="0.9"/>
    <joint name="phantomx_pincher_arm_wrist_flex_joint" value="1.0"/>
  </group_state>

  <group_state name="pre_drop_yellow" group="arm">
    <joint name="phantomx_pincher_arm_shoulder_pan_joint" value="-1.675"/>
    <joint name="phantomx_pincher_arm_shoulder_lift_joint" value="-0.35"/>
    <joint name="phantomx_pincher_arm_elbow_flex_joint" value="0.9"/>
    <joint name="phantomx_pincher_arm_wrist_flex_joint" value="1.0"/>
  </group_state>

  <group_state name="open" group="gripper">
    <joint name="phantomx_pincher_gripper_finger1_joint" value="0.0158"/>
    <joint name="phantomx_pincher_gripper_finger2_joint" value="0.0158"/>
  </group_state>

  <group_state name="closed" group="gripper">
    <joint name="phantomx_pincher_gripper_finger1_joint" value="0.001"/>
    <joint name="phantomx_pincher_gripper_finger2_joint" value="0.001"/>
  </group_state>

  <!-- DISABLE COLLISIONS -->
  <disable_collisions link1="baseFija_link" link2="caseBaseRobot_link" reason="Adjacent"/>
  <disable_collisions link1="baseFija_link" link2="phantomx_pincher_arm_base_link" reason="Never"/>
  <disable_collisions link1="caseBaseRobot_link" link2="phantomx_pincher_arm_base_link" reason="Adjacent"/>
  <disable_collisions link1="phantomx_pincher_arm_base_link" link2="phantomx_pincher_arm_shoulder_pan_link" reason="Adjacent"/>
  <disable_collisions link1="phantomx_pincher_arm_shoulder_pan_link" link2="phantomx_pincher_arm_shoulder_lift_link" reason="Adjacent"/>
  <disable_collisions link1="phantomx_pincher_arm_shoulder_lift_link" link2="phantomx_pincher_arm_elbow_flex_link" reason="Adjacent"/>
  <disable_collisions link1="phantomx_pincher_arm_elbow_flex_link" link2="phantomx_pincher_arm_wrist_flex_link" reason="Adjacent"/>
  <disable_collisions link1="phantomx_pincher_arm_wrist_flex_link" link2="phantomx_pincher_gripper_finger_base_link" reason="Adjacent"/>
  <disable_collisions link1="phantomx_pincher_gripper_finger_base_link" link2="phantomx_pincher_gripper_finger1_link" reason="Adjacent"/>
  <disable_collisions link1="phantomx_pincher_gripper_finger_base_link" link2="phantomx_pincher_gripper_finger2_link" reason="Adjacent"/>
  <disable_collisions link1="phantomx_pincher_gripper_finger1_link" link2="phantomx_pincher_gripper_finger2_link" reason="Never"/>

</robot>
